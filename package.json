{
  "name": "finn-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {"node": ">=24 <25"},
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner --host 127.0.0.1",
    "lint": "biome lint src vite.config.ts --error-on-warnings",
    "format": "biome format --write src vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:contracts": "node --test contracts/checks/contracts.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:contracts && npm test && npm run build"
  },
  "dependencies": {"react": "19.3.1", "react-dom": "19.3.1"},
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
